"""
06_train_classifiers.py — Stage 6: Raga Classification

Trains and evaluates two classifiers:
  1. SVM (RBF kernel) on handcrafted features
  2. LSTM on raw swara token sequences

Evaluates with stratified 5-fold cross-validation.
Produces confusion matrices, per-raga metrics, and comparison tables.

Usage:
    python scripts/06_train_classifiers.py
    python scripts/06_train_classifiers.py --skip-lstm          # SVM only (fast)
    python scripts/06_train_classifiers.py --feature-set pcd    # specific feature set
"""
import argparse
import json
import pickle
from pathlib import Path

import numpy as np
import pandas as pd
import yaml
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
import seaborn as sns

from sklearn.svm import SVC
from sklearn.preprocessing import LabelEncoder, StandardScaler
from sklearn.model_selection import StratifiedKFold, GridSearchCV
from sklearn.metrics import (
    classification_report, confusion_matrix, accuracy_score, f1_score
)
from sklearn.pipeline import Pipeline

from tqdm import tqdm


def repo_root() -> Path:
    return Path(__file__).resolve().parents[1]


def ensure_dir(p: Path) -> None:
    p.mkdir(parents=True, exist_ok=True)


def load_cfg(cfg_path: str) -> dict:
    with open(cfg_path, "r", encoding="utf-8") as f:
        return yaml.safe_load(f)


# ── Swara definitions (for LSTM tokenization) ───────────────────

SWARA_NAMES = ["Sa", "Ri1", "Ri2", "Ga1", "Ga2", "Ma1", "Ma2",
               "Pa", "Da1", "Da2", "Ni1", "Ni2"]
SWARA_TO_IDX = {s: i + 1 for i, s in enumerate(SWARA_NAMES)}  # 0 = padding
SWARA_TO_IDX["glide"] = len(SWARA_NAMES) + 1
SWARA_TO_IDX["silence"] = 0  # same as padding
VOCAB_SIZE = len(SWARA_NAMES) + 2  # swaras + glide + padding


# ── SVM Training ─────────────────────────────────────────────────

def train_svm(X: np.ndarray, y: np.ndarray, label_names: list,
              cv_folds: int = 5, output_dir: Path = None):
    """
    Train SVM with grid search and cross-validation.
    Returns: results dict with metrics.
    """
    print(f"\n{'='*60}")
    print(f"SVM CLASSIFIER — {X.shape[1]} features, {len(label_names)} classes")
    print(f"{'='*60}")

    # Pipeline: scale → SVM
    pipe = Pipeline([
        ("scaler", StandardScaler()),
        ("svm", SVC(kernel="rbf", probability=True, random_state=42)),
    ])

    # Grid search parameters
    param_grid = {
        "svm__C": [0.1, 1, 10, 100],
        "svm__gamma": ["scale", 0.01, 0.1],
    }

    skf = StratifiedKFold(n_splits=cv_folds, shuffle=True, random_state=42)

    # Grid search with cross-validation
    print(f"Running {cv_folds}-fold grid search...")
    grid = GridSearchCV(
        pipe, param_grid, cv=skf, scoring="f1_weighted",
        n_jobs=-1, verbose=0, refit=True
    )
    grid.fit(X, y)

    print(f"Best params: {grid.best_params_}")
    print(f"Best CV F1 (weighted): {grid.best_score_:.4f}")

    # Full cross-validation with best model for detailed metrics
    best_pipe = grid.best_estimator_

    all_y_true = []
    all_y_pred = []
    all_y_prob = []
    fold_accuracies = []

    for fold, (train_idx, val_idx) in enumerate(skf.split(X, y)):
        X_train, X_val = X[train_idx], X[val_idx]
        y_train, y_val = y[train_idx], y[val_idx]

        # Clone and fit
        from sklearn.base import clone
        fold_pipe = clone(best_pipe)
        fold_pipe.fit(X_train, y_train)

        y_pred = fold_pipe.predict(X_val)
        y_prob = fold_pipe.predict_proba(X_val)

        all_y_true.extend(y_val)
        all_y_pred.extend(y_pred)
        all_y_prob.extend(y_prob)
        fold_accuracies.append(accuracy_score(y_val, y_pred))

    all_y_true = np.array(all_y_true)
    all_y_pred = np.array(all_y_pred)

    # Metrics
    acc = accuracy_score(all_y_true, all_y_pred)
    f1_w = f1_score(all_y_true, all_y_pred, average="weighted")
    f1_m = f1_score(all_y_true, all_y_pred, average="macro")

    print(f"\nOverall accuracy: {acc:.4f}")
    print(f"F1 (weighted):    {f1_w:.4f}")
    print(f"F1 (macro):       {f1_m:.4f}")
    print(f"Fold accuracies:  {[f'{a:.3f}' for a in fold_accuracies]}")
    print(f"\nClassification Report:")
    report = classification_report(all_y_true, all_y_pred,
                                    target_names=label_names, zero_division=0)
    print(report)

    # Save the trained model (refit on full data)
    if output_dir:
        model_path = output_dir / "svm_model.pkl"
        with open(model_path, "wb") as f:
            pickle.dump(grid.best_estimator_, f)
        print(f"Model saved: {model_path}")

    return {
        "accuracy": acc,
        "f1_weighted": f1_w,
        "f1_macro": f1_m,
        "fold_accuracies": fold_accuracies,
        "best_params": grid.best_params_,
        "y_true": all_y_true,
        "y_pred": all_y_pred,
        "report": report,
    }


# ── LSTM Training ────────────────────────────────────────────────

def get_swara_token_sequence_with_glides(swara_labels: np.ndarray) -> list:
    """Convert frame-level labels to collapsed token sequence, keeping glides."""
    tokens = []
    prev = None
    for label in swara_labels:
        if label == "silence":
            prev = None
            continue
        if label != prev:
            tokens.append(label)
            prev = label
    return tokens


def pad_sequences(sequences: list, max_len: int) -> np.ndarray:
    """Pad/truncate token index sequences to fixed length."""
    padded = np.zeros((len(sequences), max_len), dtype=np.int64)
    for i, seq in enumerate(sequences):
        length = min(len(seq), max_len)
        padded[i, :length] = seq[:length]
    return padded


def train_lstm(swara_dir: Path, meta_df: pd.DataFrame,
               label_encoder: LabelEncoder, cv_folds: int = 5,
               output_dir: Path = None, root: Path = None):
    """
    Train an LSTM on raw swara token sequences.
    Returns: results dict with metrics.
    """
    import torch
    import torch.nn as nn
    from torch.utils.data import DataLoader, TensorDataset

    print(f"\n{'='*60}")
    print(f"LSTM CLASSIFIER — {len(meta_df)} segments, {len(label_encoder.classes_)} classes")
    print(f"{'='*60}")

    device = "cuda" if torch.cuda.is_available() else "cpu"
    print(f"Device: {device}")

    # --- Build token sequences from swara traces
    all_sequences = []
    all_labels = []

    for _, row in meta_df.iterrows():
        swara_npz_path = root / row["swara_npz"]
        sdata = np.load(swara_npz_path, allow_pickle=True)
        swara_labels = sdata["swara_labels"]

        tokens = get_swara_token_sequence_with_glides(swara_labels)
        token_indices = [SWARA_TO_IDX.get(t, 0) for t in tokens]
        all_sequences.append(token_indices)

        raga_label = label_encoder.transform([row["raga"]])[0]
        all_labels.append(raga_label)

    # Pad to fixed length
    max_len = min(200, max(len(s) for s in all_sequences))
    X_seq = pad_sequences(all_sequences, max_len)
    y_seq = np.array(all_labels)

    print(f"Sequence length (padded): {max_len}")
    print(f"Vocab size: {VOCAB_SIZE}")

    # --- LSTM Model
    class RagaLSTM(nn.Module):
        def __init__(self, vocab_size, embed_dim, hidden_dim, n_classes, dropout=0.3):
            super().__init__()
            self.embedding = nn.Embedding(vocab_size, embed_dim, padding_idx=0)
            self.lstm = nn.LSTM(embed_dim, hidden_dim, batch_first=True,
                                bidirectional=True, dropout=dropout, num_layers=2)
            self.dropout = nn.Dropout(dropout)
            self.fc = nn.Linear(hidden_dim * 2, n_classes)  # *2 for bidirectional

        def forward(self, x):
            emb = self.embedding(x)
            lstm_out, (hidden, _) = self.lstm(emb)
            # Concatenate final hidden states from both directions
            hidden_cat = torch.cat((hidden[-2], hidden[-1]), dim=1)
            out = self.dropout(hidden_cat)
            return self.fc(out)

    # --- Cross-validation
    n_classes = len(label_encoder.classes_)
    skf = StratifiedKFold(n_splits=cv_folds, shuffle=True, random_state=42)

    all_y_true = []
    all_y_pred = []
    fold_accuracies = []

    for fold, (train_idx, val_idx) in enumerate(skf.split(X_seq, y_seq)):
        print(f"\n  Fold {fold + 1}/{cv_folds}")

        X_train = torch.LongTensor(X_seq[train_idx]).to(device)
        y_train = torch.LongTensor(y_seq[train_idx]).to(device)
        X_val = torch.LongTensor(X_seq[val_idx]).to(device)
        y_val_np = y_seq[val_idx]

        train_ds = TensorDataset(X_train, y_train)
        train_dl = DataLoader(train_ds, batch_size=32, shuffle=True)

        model = RagaLSTM(
            vocab_size=VOCAB_SIZE,
            embed_dim=32,
            hidden_dim=64,
            n_classes=n_classes,
            dropout=0.3
        ).to(device)

        optimizer = torch.optim.Adam(model.parameters(), lr=0.001)
        criterion = nn.CrossEntropyLoss()

        # Training loop with early stopping
        best_val_acc = 0
        patience = 10
        patience_counter = 0

        for epoch in range(100):
            model.train()
            total_loss = 0
            for xb, yb in train_dl:
                optimizer.zero_grad()
                logits = model(xb)
                loss = criterion(logits, yb)
                loss.backward()
                optimizer.step()
                total_loss += loss.item()

            # Validation
            model.eval()
            with torch.no_grad():
                val_logits = model(X_val)
                val_preds = val_logits.argmax(dim=1).cpu().numpy()
                val_acc = accuracy_score(y_val_np, val_preds)

            if val_acc > best_val_acc:
                best_val_acc = val_acc
                best_preds = val_preds.copy()
                patience_counter = 0
            else:
                patience_counter += 1

            if patience_counter >= patience:
                print(f"    Early stop at epoch {epoch + 1}, best val acc: {best_val_acc:.4f}")
                break

        if patience_counter < patience:
            print(f"    Completed 100 epochs, best val acc: {best_val_acc:.4f}")

        all_y_true.extend(y_val_np)
        all_y_pred.extend(best_preds)
        fold_accuracies.append(best_val_acc)

    all_y_true = np.array(all_y_true)
    all_y_pred = np.array(all_y_pred)

    # Metrics
    acc = accuracy_score(all_y_true, all_y_pred)
    f1_w = f1_score(all_y_true, all_y_pred, average="weighted")
    f1_m = f1_score(all_y_true, all_y_pred, average="macro")

    label_names = label_encoder.classes_

    print(f"\nOverall accuracy: {acc:.4f}")
    print(f"F1 (weighted):    {f1_w:.4f}")
    print(f"F1 (macro):       {f1_m:.4f}")
    print(f"Fold accuracies:  {[f'{a:.3f}' for a in fold_accuracies]}")
    print(f"\nClassification Report:")
    report = classification_report(all_y_true, all_y_pred,
                                    target_names=label_names, zero_division=0)
    print(report)

    return {
        "accuracy": acc,
        "f1_weighted": f1_w,
        "f1_macro": f1_m,
        "fold_accuracies": fold_accuracies,
        "y_true": all_y_true,
        "y_pred": all_y_pred,
        "report": report,
    }


# ── Visualization ────────────────────────────────────────────────

def plot_confusion_matrix(y_true, y_pred, label_names, title, out_path):
    """Plot and save confusion matrix."""
    cm = confusion_matrix(y_true, y_pred)
    cm_norm = cm.astype(float) / cm.sum(axis=1, keepdims=True)
    cm_norm = np.nan_to_num(cm_norm)

    fig, ax = plt.subplots(figsize=(12, 10))
    sns.heatmap(cm_norm, xticklabels=label_names, yticklabels=label_names,
                cmap="Blues", annot=True, fmt=".2f", ax=ax, square=True,
                cbar_kws={"shrink": 0.7})
    ax.set_xlabel("Predicted")
    ax.set_ylabel("True")
    ax.set_title(title)
    plt.xticks(rotation=45, ha="right")
    plt.yticks(rotation=0)
    plt.tight_layout()
    plt.savefig(out_path, dpi=150)
    plt.close(fig)


def plot_comparison_bar(results_dict: dict, out_path: Path):
    """Bar chart comparing different model/feature combinations."""
    names = list(results_dict.keys())
    accuracies = [r["accuracy"] for r in results_dict.values()]
    f1_scores = [r["f1_weighted"] for r in results_dict.values()]

    x = np.arange(len(names))
    width = 0.35

    fig, ax = plt.subplots(figsize=(12, 6))
    bars1 = ax.bar(x - width / 2, accuracies, width, label="Accuracy", color="steelblue")
    bars2 = ax.bar(x + width / 2, f1_scores, width, label="F1 (weighted)", color="darkorange")

    ax.set_ylabel("Score")
    ax.set_title("Model Comparison")
    ax.set_xticks(x)
    ax.set_xticklabels(names, rotation=30, ha="right")
    ax.legend()
    ax.set_ylim(0, 1)

    # Add value labels
    for bar in bars1:
        ax.text(bar.get_x() + bar.get_width() / 2, bar.get_height() + 0.01,
                f"{bar.get_height():.3f}", ha="center", va="bottom", fontsize=8)
    for bar in bars2:
        ax.text(bar.get_x() + bar.get_width() / 2, bar.get_height() + 0.01,
                f"{bar.get_height():.3f}", ha="center", va="bottom", fontsize=8)

    plt.tight_layout()
    plt.savefig(out_path, dpi=150)
    plt.close(fig)


def main():
    parser = argparse.ArgumentParser(description="Train raga classifiers")
    parser.add_argument("--skip-lstm", action="store_true",
                        help="Skip LSTM training (SVM only)")
    parser.add_argument("--feature-set", choices=["transition", "pcd", "combined",
                                                    "bigram", "full_combined"],
                        default=None,
                        help="Run only one feature set (default: run all)")
    parser.add_argument("--cv-folds", type=int, default=5)
    args = parser.parse_args()

    root = repo_root()

    # --- Load features
    feat_dir = root / "data" / "processed" / "features"
    feat_path = feat_dir / "features_all.npz"
    if not feat_path.exists():
        raise FileNotFoundError(f"Missing: {feat_path}. Run 05_feature_extraction.py first.")

    fdata = np.load(feat_path, allow_pickle=True)
    meta_csv = feat_dir / "features_meta.csv"
    meta_df = pd.read_csv(meta_csv)

    # Also load swara CSV for LSTM
    swara_csv = root / "data" / "processed" / "swara_all.csv"
    swara_df = pd.read_csv(swara_csv) if swara_csv.exists() else None

    ragas = fdata["ragas"]
    le = LabelEncoder()
    y = le.fit_transform(ragas)
    label_names = list(le.classes_)

    print(f"Dataset: {len(y)} segments, {len(label_names)} ragas")
    print(f"Classes: {label_names}")

    # --- Output dirs
    model_dir = root / "models"
    fig_dir = root / "outputs" / "figures" / "classification"
    results_dir = root / "outputs" / "results"
    ensure_dir(model_dir)
    ensure_dir(fig_dir)
    ensure_dir(results_dir)

    # --- Define feature sets to evaluate
    feature_sets = {
        "SVM_transition": fdata["transition"],
        "SVM_pcd": fdata["pcd"],
        "SVM_combined": fdata["combined"],
    }

    if args.feature_set:
        # Run only specified feature set
        key = f"SVM_{args.feature_set}"
        if key in feature_sets:
            feature_sets = {key: feature_sets[key]}
        else:
            feature_sets = {f"SVM_{args.feature_set}": fdata[args.feature_set]}

    # --- Train SVMs
    all_results = {}

    for name, X in feature_sets.items():
        print(f"\n\n{'#'*60}")
        print(f"# {name}")
        print(f"{'#'*60}")

        results = train_svm(X, y, label_names, cv_folds=args.cv_folds,
                           output_dir=model_dir)
        all_results[name] = results

        # Confusion matrix
        plot_confusion_matrix(
            results["y_true"], results["y_pred"], label_names,
            f"Confusion Matrix — {name}\n(Acc: {results['accuracy']:.3f}, "
            f"F1: {results['f1_weighted']:.3f})",
            fig_dir / f"cm_{name}.png"
        )

    # --- Train LSTM
    if not args.skip_lstm and swara_df is not None:
        # Merge swara paths with meta
        lstm_meta = meta_df.merge(
            swara_df[["track_id", "segment_index", "swara_npz"]],
            on=["track_id", "segment_index"],
            how="inner"
        )

        if len(lstm_meta) > 0:
            lstm_results = train_lstm(
                swara_dir=root / "data" / "processed" / "swara",
                meta_df=lstm_meta,
                label_encoder=le,
                cv_folds=args.cv_folds,
                output_dir=model_dir,
                root=root,
            )
            all_results["LSTM_swara_seq"] = lstm_results

            plot_confusion_matrix(
                lstm_results["y_true"], lstm_results["y_pred"], label_names,
                f"Confusion Matrix — LSTM\n(Acc: {lstm_results['accuracy']:.3f}, "
                f"F1: {lstm_results['f1_weighted']:.3f})",
                fig_dir / "cm_LSTM_swara_seq.png"
            )

    # --- Comparison chart
    if len(all_results) > 1:
        plot_comparison_bar(all_results, fig_dir / "model_comparison.png")

    # --- Save results summary
    summary = {}
    for name, res in all_results.items():
        summary[name] = {
            "accuracy": float(res["accuracy"]),
            "f1_weighted": float(res["f1_weighted"]),
            "f1_macro": float(res["f1_macro"]),
            "fold_accuracies": [float(a) for a in res["fold_accuracies"]],
        }
        if "best_params" in res:
            summary[name]["best_params"] = {
                k: str(v) for k, v in res["best_params"].items()
            }

    results_json = results_dir / "classification_results.json"
    with open(results_json, "w", encoding="utf-8") as f:
        json.dump(summary, f, indent=2, ensure_ascii=False)

    # --- Final summary
    print(f"\n\n{'='*60}")
    print(f"FINAL RESULTS SUMMARY")
    print(f"{'='*60}")
    print(f"{'Model':<25} {'Accuracy':>10} {'F1 (weighted)':>14} {'F1 (macro)':>12}")
    print(f"{'-'*61}")
    for name, res in all_results.items():
        print(f"{name:<25} {res['accuracy']:>10.4f} {res['f1_weighted']:>14.4f} "
              f"{res['f1_macro']:>12.4f}")

    print(f"\nResults JSON: {results_json}")
    print(f"Confusion matrices: {fig_dir}")
    print(f"Model files: {model_dir}")

    # Save label encoder for Streamlit
    with open(model_dir / "label_encoder.pkl", "wb") as f:
        pickle.dump(le, f)


if __name__ == "__main__":
    main()
